# ==============================================================================
# AUTORESEARCHING - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# --- KAFKA ---
# Chạy ngoài Docker (venv): localhost:9092
# Chạy trong Docker network: kafka:9092
KAFKA="localhost:9092"

# --- REDIS & REDIS STACK ---
# Redis Stack hỗ trợ đầy đủ RediSearch & LangGraph Checkpoint
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PWD="redis_password_local"
REDIS_TTL=3600
REDIS="redis://:redis_password_local@localhost:6379/0"
REDIS_STACK="redis://:redis_password_local@localhost:6379/0"

# --- MONGODB ---
MONGO_CONNECTION_STRING="mongodb://root:mongo_password_local@localhost:27017/?authSource=admin"

# --- QDRANT (VECTOR DB) ---
QDRANT_URL="http://localhost:6333"
EMBEDDING_MODEL="text-embedding-3-small"

# --- MINIO (OBJECT STORAGE S3) ---
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY_ID="minio_admin"
MINIO_SECRET_ACCESS_KEY="minio_password_local"
MINIO_DOMAIN="http://localhost:9000"
MINIO_BUCKET="autoresearching"
MINIO_BUCKET_ANALYSIS="analysis"
MINIO_PREFIX="documents"

# --- LLM & EXTERNAL APIS (Điền key của bạn khi chạy) ---
OPEN_AI_KEY=""
GEMINI_KEY=""
GROQ_API_KEY=""
SERP_KEY=""
OPEN_ALEX_EMAIL="test@example.com"
OPEN_ALEX_USER="autoresearch"
OPEN_ALEX_KEY=""

# --- SYSTEM & BACKEND HEALTH CHECK ---
API_KEY_ID="default_local_key"
TMP_FOLDER="/tmp/autoresearching"
LOCALLLM_BASE_URL="http://localhost:8000/v1"
